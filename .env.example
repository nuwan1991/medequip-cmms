# Copy to .env and adjust. Never commit the real .env file.

# PostgreSQL (matches infra/docker-compose.yml)
DATABASE_URL=postgresql://medequip:medequip@localhost:5432/medequip?schema=public

# API
PORT=3000
NODE_ENV=development

# Object storage (MinIO locally, S3 / Azure Blob in cloud)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=medequip
S3_ACCESS_KEY=medequip
S3_SECRET_KEY=medequip-secret
