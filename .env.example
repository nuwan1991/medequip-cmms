# Copy to .env and adjust. Never commit the real .env file.

# PostgreSQL (matches infra/docker-compose.yml)
# Owner role: migrations, seed and the API's system/auth queries.
DATABASE_URL=postgresql://medequip:medequip@localhost:5432/medequip?schema=public
# Restricted role used by the API for tenant data (Row-Level Security applies).
# Created by infra/postgres/init.sql in Docker. Required in production.
APP_DATABASE_URL=postgresql://medequip_app:medequip_app@localhost:5432/medequip?schema=public

# API
PORT=3000
NODE_ENV=development

# Object storage (MinIO locally, S3 / Azure Blob in cloud)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=medequip
S3_ACCESS_KEY=medequip
S3_SECRET_KEY=medequip-secret

# Auth - JWT signing secret (min 32 chars). Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-dev-only-change-me-0123456789
# Access token lifetime (seconds) and refresh session lifetime (days)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# Set to true when served over HTTPS (production)
COOKIE_SECURE=false

# Seed: initial password for admin@demo.local (dev default: ChangeMe-2026!)
SEED_ADMIN_PASSWORD=
